# Production Environment Configuration
# DO NOT commit this file with real values
# Set these as secrets in your deployment platform

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key

# Python API Configuration (production API)
EXPO_PUBLIC_PYTHON_API_URL=https://api.5cswipe.com

# Environment
EXPO_PUBLIC_ENV=production

# Disable debugging in production
EXPO_PUBLIC_DEBUG=false
